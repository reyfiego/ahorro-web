rules_version = '2';

// ============================================================
// Reglas de seguridad de Firestore para AhorraMeta Negocios
//
// Regla de oro: cada usuario solo toca lo suyo.
// Sin esto, cualquiera con la apiKey puede leer los datos de todos.
// Pegalas en: Consola de Firebase → Firestore → Pestaña "Reglas".
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // El documento de perfil: usuarios/{uid}
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Todas las subcolecciones de datos:
      // movimientos, categorias, presupuestos, metas, clientes,
      // proveedores, facturas, obligaciones, productos, empleados, bitacora
      match /{coleccion}/{documento} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Todo lo demás queda cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
